<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>11.0</LangVersion>
        <PackageId>SpiceAI</PackageId>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.2.0</Version>
        <Description>Spice.ai Dotnet SDK</Description>
        <Authors>Spice.ai OSS</Authors>
        <Nullable>enable</Nullable>
        <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Apache.Arrow" Version="18.0.0" />
        <PackageReference Include="Apache.Arrow.Flight" Version="18.0.0" />
        <PackageReference Include="Grpc.Core.Api" Version="2.70.0" />
        <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
        <PackageReference Include="Grpc.Net.Common" Version="2.70.0" />
        <PackageReference Include="Polly" Version="8.5.0" />

        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SpiceTest</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>


</Project>
