<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>SpiceAI</PackageId>
        <Version>0.3.0</Version>
        <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>

        <!-- NuGet Package Metadata -->
        <Description>Official .NET SDK for Spice.ai - Query data with Apache Arrow Flight and parameterized queries using ADBC.</Description>
        <Authors>Spice AI, Inc.</Authors>
        <Company>Spice AI, Inc.</Company>
        <Copyright>Copyright © 2024-2026 Spice AI, Inc.</Copyright>
        <PackageTags>spice;spiceai;arrow;flight;adbc;sql;data;analytics;grpc</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/spiceai/spice-dotnet</PackageProjectUrl>
        <RepositoryUrl>https://github.com/spiceai/spice-dotnet.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>See https://github.com/spiceai/spice-dotnet/releases</PackageReleaseNotes>

        <!-- Generate XML documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!-- Include README in package -->
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Apache.Arrow" Version="22.1.0" />
        <PackageReference Include="Apache.Arrow.Adbc" Version="0.21.0" />
        <PackageReference Include="Apache.Arrow.Adbc.Drivers.Interop.FlightSql" Version="0.21.0" />
        <PackageReference Include="Apache.Arrow.Flight" Version="22.1.0" />
        <PackageReference Include="Grpc.Core.Api" Version="2.71.0" />
        <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
        <PackageReference Include="Grpc.Net.Common" Version="2.71.0" />
        <PackageReference Include="Polly" Version="8.5.0" />

        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SpiceTest</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>


</Project>
